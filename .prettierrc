{
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 90,
  "singleQuote": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "trailingComma": "none",
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": ["prettier-plugin-tailwindcss", "@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^react", "^next", "<THIRD_PARTY_MODULES>", "^@/", "^[./]"]
}
